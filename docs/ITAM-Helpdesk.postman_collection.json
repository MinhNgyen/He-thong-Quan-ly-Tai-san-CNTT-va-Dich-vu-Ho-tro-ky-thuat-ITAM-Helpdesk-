{
  "info": {
    "name": "ITAM Helpdesk API",
    "description": "REST API ITAM Helpdesk (Bearer token).\n\n1. Chạy 'Auth > Đăng nhập' (đổi email/mật khẩu theo vai trò muốn thử): token được lưu tự động vào biến {{token}}.\n2. Các request còn lại tự gửi kèm 'Authorization: Bearer {{token}}'.\n\nTài khoản demo (sau khi seed): admin@example.com / technician@example.com / employee@example.com, mật khẩu Password123!\nLưu ý: API đăng nhập giới hạn 5 yêu cầu/phút/IP (BM10). Chạy cả bộ liên tiếp nhiều lần có thể nhận 429; chờ 1 phút rồi chạy lại.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "ticketId",
      "value": "1"
    },
    {
      "key": "assetId",
      "value": "1"
    },
    {
      "key": "adminToken",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Đăng nhập (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Đăng nhập thành công', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', json.data.token);",
                  "pm.collectionVariables.set('adminToken', json.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Thông tin tôi",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            }
          }
        },
        {
          "name": "Làm mới token (luân chuyển)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/refresh-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "refresh-token"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Làm mới thành công (200)', () => pm.response.to.have.status(200));",
                  "pm.test('Token mới khác token cũ', () => pm.expect(json.data.token).to.not.eql(pm.collectionVariables.get('token')));",
                  "pm.collectionVariables.set('token', json.data.token);",
                  "pm.collectionVariables.set('adminToken', json.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Gọi API không có token → 401 (thân lỗi thống nhất)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Thân lỗi { success:false, message }', () => { const j = pm.response.json(); pm.expect(j.success).to.eql(false); pm.expect(j.message).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng nhập (Technician)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"technician@example.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Đăng nhập thành công', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', json.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng nhập (Employee)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employee@example.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Đăng nhập thành công', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', json.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng xuất",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tài sản",
      "item": [
        {
          "name": "Danh sách (Admin, Technician)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/assets?q=laptop&status=available&page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assets"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "laptop",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "available",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": true
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) { pm.collectionVariables.set('assetId', json.data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Chi tiết",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/assets/{{assetId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assets",
                "{{assetId}}"
              ]
            }
          }
        },
        {
          "name": "Cây tài sản con (truy vấn đệ quy)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/assets/{{assetId}}/descendants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assets",
                "{{assetId}}",
                "descendants"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('data là mảng, mỗi phần tử có depth', () => { pm.expect(j.data).to.be.an('array'); j.data.forEach(n => pm.expect(n.depth).to.be.at.least(1)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Thêm (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/assets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asset_code\": \"LT-900\",\n  \"name\": \"Laptop Dell Latitude\",\n  \"category_id\": 1,\n  \"status\": \"available\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) { pm.collectionVariables.set('assetId', json.data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Sửa (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/assets/{{assetId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assets",
                "{{assetId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asset_code\": \"LT-900\",\n  \"name\": \"Laptop Dell Latitude 5440\",\n  \"category_id\": 1,\n  \"status\": \"in_use\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Xóa (Admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/assets/{{assetId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assets",
                "{{assetId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Phiếu hỗ trợ",
      "item": [
        {
          "name": "Dữ liệu tham chiếu (danh mục, ưu tiên, tài sản)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tickets/options",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tickets",
                "options"
              ]
            }
          }
        },
        {
          "name": "Danh sách",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tickets?status=open&q=laptop&page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tickets"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "open",
                  "disabled": true
                },
                {
                  "key": "q",
                  "value": "laptop",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": true
                }
              ]
            }
          }
        },
