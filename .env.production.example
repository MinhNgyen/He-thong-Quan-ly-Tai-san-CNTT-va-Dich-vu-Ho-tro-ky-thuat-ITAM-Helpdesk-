# Mẫu cấu hình môi trường TRỰC TUYẾN (không chứa giá trị bí mật thật). Sao chép thành .env trên máy chủ rồi điền giá trị.
APP_NAME="ITAM Helpdesk"
APP_ENV=production
# BM9: tắt hiển thị lỗi chi tiết cho người dùng cuối
APP_DEBUG=false
APP_KEY=
APP_URL=https://TEN-MIEN-CUA-NHOM.example
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# BM7: cookie phiên chỉ gửi qua HTTPS, không đọc được bằng JavaScript
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

# Hosting miễn phí thường không có tiến trình nền: dùng cache dạng file, hàng đợi đồng bộ
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Hosting không có thư điện tử theo tên miền: dùng SMTP bên ngoài, hoặc để "log" nếu chưa cần gửi thư thật
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Đặt true nếu chạy sau reverse proxy (Render, Railway, Koyeb...)
TRUST_PROXIES=false

SLA_TIMEZONE=Asia/Ho_Chi_Minh
PROJECT_GROUP="Nhóm [số nhóm]"
PROJECT_CLASS="Lớp học phần [mã lớp]"

# Khóa cho điểm cuối quét SLA (xem docs/TRIEN_KHAI_TRUC_TUYEN.md). Tạo chuỗi ngẫu nhiên dài, không đưa vào repository.
SLA_CRON_KEY=
